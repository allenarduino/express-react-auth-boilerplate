# Database
DATABASE_URL=postgresql://app_user:app_password@localhost:5433/express_react_auth

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration
EMAIL_PROVIDER=resend
EMAIL_FROM=Auth Starter <onboarding@resend.dev>
RESEND_API_KEY=your-resend-api-key-here

# SMTP Configuration (alternative to Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# App Configuration
APP_URL=http://localhost:4001
FRONTEND_URL=http://localhost:5173
PORT=4001
NODE_ENV=development

# Google OAuth (local callback: http://localhost:4001/api/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
